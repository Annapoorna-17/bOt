# Multi-tenant RAG Service Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Required: OpenAI Configuration
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# Required: Pinecone Configuration
# ============================================
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=your-pinecone-index-name

# ============================================
# Required: Database Configuration (MySQL)
# ============================================
# Option 1: Full connection string
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/rag_db

# Option 2: Individual components (if DATABASE_URL is not set)
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=rag_db

# ============================================
# Optional: Server Configuration
# ============================================
# Server port (default: 8000)
PORT=8000

# Server host (default: 0.0.0.0)
HOST=127.0.0.1

# Enable auto-reload for development (default: true)
RELOAD=true

# ============================================
# Optional: Authentication
# ============================================
# Superadmin token for company creation (default: B946C6F2747914D24C1F6C74F5AB5291)
SUPERADMIN_TOKEN=B946C6F2747914D24C1F6C74F5AB5291

# ============================================
# Optional: AI Model Configuration
# ============================================
# Embedding model (default: text-embedding-3-large)
OPENAI_EMBED_MODEL=text-embedding-3-large

# Chat model (default: gpt-4o)
OPENAI_CHAT_MODEL=gpt-4o
